# === Le Point Chablais — portail abonnement ===
# Copiez ce fichier en ".env.local" (local) et remplissez les valeurs.
# En prod : définir ces variables dans le panneau Infomaniak (pas de fichier).

# --- Base de données MariaDB (obligatoire) ---
# Local : mysql://root:MOTDEPASSE@127.0.0.1:3306/pointchablais_abo
# Prod  : utilisateur dédié, jamais root.
DATABASE_URL=mysql://root:root@127.0.0.1:3306/pointchablais_abo
DB_POOL_SIZE=10

# --- Sessions (obligatoire en prod) : longue chaîne aléatoire ---
SESSION_SECRET=changez-moi-par-une-longue-chaine-aleatoire

# --- Fichiers uploadés (PDF + couvertures). Vide = ./storage ---
STORAGE_DIR=

# --- Stripe (MODE TEST) ---
# Vide = mode simulé (abonnement activé sans paiement, pour la démo).
# Clés TEST : sk_test_... / whsec_...
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# (Optionnel) IDs de prix Stripe (sinon prix défini à la volée depuis les packs)
STRIPE_PRICE_MENSUEL=
STRIPE_PRICE_ANNUEL=

# --- E-mails (optionnel) ---
SMTP_URL=
